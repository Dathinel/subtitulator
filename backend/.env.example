# Variables de entorno para desarrollo local.
# Copia este archivo a backend/.env y ajusta los valores si lo necesitas.
APP_NAME=Subtitulator
APP_VERSION=0.1.0

# Modelo de transcripción (faster-whisper, local)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Límites de entrada
MAX_FILE_SIZE_MB=500
MAX_DURATION_SECONDS=3600
